<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>D'Studio AR — Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --accent: #c8a96e;
      --accent-dim: rgba(200, 169, 110, 0.1);
      --accent-border: rgba(200, 169, 110, 0.25);
      --bg: #080808;
      --surface: #101010;
      --surface2: #161616;
      --border: #1e1e1e;
      --text: #efefef;
      --muted: #555;
      --muted2: #2a2a2a;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: var(--bg);
      font-family: 'DM Sans', sans-serif;
      color: var(--text);
      min-height: 100vh;
    }

    /* ── LOGIN ── */
    #loginSection {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 40px 20px;
      background: radial-gradient(ellipse at 50% 0%, rgba(200,169,110,0.06) 0%, transparent 70%);
    }

    .login-logo {
      width: 64px;
      filter: invert(1);
      opacity: 0.85;
      margin-bottom: 20px;
    }

    .login-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 30px;
      font-weight: 300;
      letter-spacing: 8px;
      text-transform: uppercase;
      margin-bottom: 6px;
      color: var(--text);
    }

    .login-sub {
      font-size: 10px;
      letter-spacing: 4px;
      color: var(--muted);
      text-transform: uppercase;
      margin-bottom: 52px;
    }

    .login-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 36px;
      width: 100%;
      max-width: 400px;
    }

    .login-box label {
      display: block;
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
    }

    .login-box input {
      width: 100%;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 16px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-size: 15px;
      outline: none;
      transition: border-color 0.2s;
      margin-bottom: 20px;
    }

    .login-box input:focus { border-color: var(--accent); }

    .error-msg {
      color: #e05555;
      font-size: 12px;
      text-align: center;
      margin-bottom: 12px;
      display: none;
      letter-spacing: 1px;
    }

    /* ── BUTTONS ── */
    .btn-primary {
      width: 100%;
      padding: 15px;
      background: var(--accent);
      color: #080808;
      border: none;
      border-radius: 50px;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 3px;
      text-transform: uppercase;
      cursor: pointer;
      transition: opacity 0.2s, transform 0.1s;
    }

    .btn-primary:hover { opacity: 0.88; }
    .btn-primary:active { transform: scale(0.98); }
    .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

    .btn-secondary {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--muted);
      padding: 7px 16px;
      border-radius: 50px;
      font-family: 'DM Sans', sans-serif;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }

    /* ── DASHBOARD ── */
    #dashboard { display: none; }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 36px;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      background: rgba(8,8,8,0.96);
      backdrop-filter: blur(16px);
      z-index: 100;
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .topbar-logo {
      width: 34px;
      filter: invert(1);
      opacity: 0.8;
    }

    .topbar-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      font-weight: 400;
      letter-spacing: 5px;
      text-transform: uppercase;
      color: var(--text);
    }

    .topbar-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .client-count {
      font-size: 10px;
      letter-spacing: 2px;
      color: var(--muted);
      text-transform: uppercase;
    }

    .client-count span { color: var(--accent); }

    /* ── GRID ── */
    .main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      padding: 28px 36px;
      max-width: 1200px;
      margin: 0 auto;
    }

    @media (max-width: 800px) {
      .main { grid-template-columns: 1fr; padding: 20px; }
      .topbar { padding: 16px 20px; }
      .stats-row { grid-template-columns: 1fr; }
      .clients-panel { grid-column: 1; }
    }

    /* ── STATS ── */
    .stats-row {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 22px 26px;
    }

    .stat-label {
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 10px;
    }

    .stat-value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 40px;
      font-weight: 300;
      color: var(--accent);
      line-height: 1;
    }

    /* ── PANELS ── */
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px;
    }

    .panel-title {
      font-size: 10px;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .panel-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    /* ── FORM ── */
    .form-group { margin-bottom: 16px; }

    .form-group label {
      display: block;
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 7px;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px 15px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-group input:focus,
    .form-group textarea:focus { border-color: var(--accent); }

    .form-group textarea {
      height: 80px;
      resize: none;
    }

    /* ── SUCCESS ── */
    .success-box {
      display: none;
      background: var(--accent-dim);
      border: 1px solid var(--accent-border);
      border-radius: 12px;
      padding: 18px;
      margin-top: 16px;
    }

    .success-box p {
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 8px;
    }

    .success-link {
      font-size: 12px;
      color: var(--text);
      word-break: break-all;
      display: block;
      margin-bottom: 12px;
      opacity: 0.6;
      line-height: 1.5;
    }

    /* ── CLIENTS ── */
    .clients-panel { grid-column: 1 / -1; }

    .client-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
      gap: 16px;
    }

    .client-item:last-child { border-bottom: none; }

    .client-info { flex: 1; min-width: 0; }

    .client-restaurant {
      font-size: 15px;
      font-weight: 500;
      margin-bottom: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .client-dish {
      font-size: 12px;
      color: var(--muted);
    }

    .client-price {
      font-size: 13px;
      color: var(--accent);
      font-weight: 500;
      white-space: nowrap;
    }

    .client-actions {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-shrink: 0;
    }

    .view-link {
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--accent);
      text-decoration: none;
      padding: 7px 16px;
      border: 1px solid var(--accent-border);
      border-radius: 50px;
      transition: all 0.2s;
      white-space: nowrap;
    }

    .view-link:hover {
      background: var(--accent);
      color: #080808;
    }

    .empty-state {
      text-align: center;
      padding: 48px 20px;
      color: var(--muted);
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .loading-state {
      text-align: center;
      padding: 32px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    /* ── HOW IT WORKS ── */
    .step {
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
    }

    .step:last-child { border-bottom: none; }

    .step-num {
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 5px;
    }

    .step-title {
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 4px;
    }

    .step-desc {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.6;
    }
  </style>
</head>
<body>

<!-- LOGIN -->
<div id="loginSection">
  <img src="D_Studio_logo.png" class="login-logo" alt="D'Studio">
  <h1 class="login-title">D'Studio</h1>
  <p class="login-sub">AR Management Portal</p>

  <div class="login-box">
    <label>Admin Password</label>
    <input type="password" id="passwordInput" placeholder="Enter password" autocomplete="current-password">
    <p class="error-msg" id="errorMsg">Incorrect password — please try again.</p>
    <button class="btn-primary" onclick="login()">Access Dashboard</button>
  </div>
</div>

<!-- DASHBOARD -->
<div id="dashboard">

  <div class="topbar">
    <div class="topbar-left">
      <img src="D_Studio_logo.png" class="topbar-logo" alt="D'Studio">
      <span class="topbar-title">D'Studio AR</span>
    </div>
    <div class="topbar-right">
      <span class="client-count">Clients: <span id="clientCountBadge">0</span></span>
      <button class="btn-secondary" onclick="logout()">Logout</button>
    </div>
  </div>

  <div class="main">

    <!-- Stats -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Total Clients</div>
        <div class="stat-value" id="statTotal">0</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">AR Menus Active</div>
        <div class="stat-value" id="statMenus">0</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Est. Monthly Revenue</div>
        <div class="stat-value" id="statRevenue">R0</div>
      </div>
    </div>

    <!-- Add Restaurant -->
    <div class="panel">
      <div class="panel-title">Add New Restaurant</div>

      <div class="form-group">
        <label>Restaurant Name *</label>
        <input type="text" id="restaurantName" placeholder="e.g. Hudson's Burger Co.">
      </div>
      <div class="form-group">
        <label>Dish Name *</label>
        <input type="text" id="dishName" placeholder="e.g. The Classic Smash">
      </div>
      <div class="form-group">
        <label>Price *</label>
        <input type="text" id="dishPrice" placeholder="e.g. R 165">
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea id="dishDescription" placeholder="Describe the dish..."></textarea>
      </div>
      <div class="form-group">
        <label>3D Model URL (GLB) *</label>
        <input type="text" id="modelUrl" placeholder="https://yoursite.vercel.app/burger.glb">
      </div>

      <button class="btn-primary" id="addBtn" onclick="addRestaurant()">Generate AR Menu</button>

      <div class="success-box" id="successBox">
        <p>AR Menu Created — Share This Link</p>
        <span class="success-link" id="menuLink"></span>
        <button class="btn-secondary" onclick="copyLink()">Copy Link</button>
      </div>
    </div>

    <!-- How It Works -->
    <div class="panel">
      <div class="panel-title">How It Works</div>

      <div class="step">
        <div class="step-num">Step 01</div>
        <div class="step-title">Fill in restaurant details</div>
        <div class="step-desc">Enter the restaurant name, dish info and your hosted GLB model URL from Vercel.</div>
      </div>
      <div class="step">
        <div class="step-num">Step 02</div>
        <div class="step-title">Generate the AR menu</div>
        <div class="step-desc">Click Generate and a unique AR menu link is created instantly for that client.</div>
      </div>
      <div class="step">
        <div class="step-num">Step 03</div>
        <div class="step-title">Create a QR code</div>
        <div class="step-desc">Take the link to qr-code-generator.com and generate a QR code for the restaurant table.</div>
      </div>
      <div class="step">
        <div class="step-num">Step 04</div>
        <div class="step-title">Client goes live</div>
        <div class="step-desc">Customers scan the QR code and see their food in AR on the table. Done.</div>
      </div>
    </div>

    <!-- Client List -->
    <div class="panel clients-panel">
      <div class="panel-title">Your Clients</div>
      <div id="clientList"><div class="loading-state">Loading clients...</div></div>
    </div>

  </div>
</div>

<script>
  const SUPABASE_URL = 'https://kynmckifaixaakpdarxn.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_QW3AQ4MxIFU3u0hXhdwUVA_IMPALYbq';
  const ADMIN_PASSWORD = 'Decl@n123';

  const { createClient } = supabase;
  const db = createClient(SUPABASE_URL, SUPABASE_KEY);

  function login() {
    const password = document.getElementById('passwordInput').value;
    if (password === ADMIN_PASSWORD) {
      document.getElementById('loginSection').style.display = 'none';
      document.getElementById('dashboard').style.display = 'block';
      loadClients();
    } else {
      document.getElementById('errorMsg').style.display = 'block';
      document.getElementById('passwordInput').value = '';
    }
  }

  function logout() {
    document.getElementById('dashboard').style.display = 'none';
    document.getElementById('loginSection').style.display = 'flex';
    document.getElementById('passwordInput').value = '';
    document.getElementById('errorMsg').style.display = 'none';
  }

  function generateSlug(restaurantName, dishName) {
    const combined = restaurantName + '-' + dishName + '-' + Date.now();
    return combined.toLowerCase()
      .replace(/[^a-z0-9]/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  async function addRestaurant() {
    const restaurantName = document.getElementById('restaurantName').value.trim();
    const dishName = document.getElementById('dishName').value.trim();
    const dishPrice = document.getElementById('dishPrice').value.trim();
    const dishDescription = document.getElementById('dishDescription').value.trim();
    const modelUrl = document.getElementById('modelUrl').value.trim();

    if (!restaurantName || !dishName || !dishPrice || !modelUrl) {
      alert('Please fill in all required fields marked with *');
      return;
    }

    const btn = document.getElementById('addBtn');
    btn.textContent = 'Generating...';
    btn.disabled = true;

    const slug = generateSlug(restaurantName, dishName);

    const { error } = await db
      .from('restaurants')
      .insert([{
        restaurant_name: restaurantName,
        dish_name: dishName,
        dish_price: dishPrice,
        dish_description: dishDescription,
        model_url: modelUrl,
        slug: slug
      }]);

    btn.textContent = 'Generate AR Menu';
    btn.disabled = false;

    if (error) {
      alert('Error saving client: ' + error.message);
      return;
    }

    const menuUrl = window.location.origin + '/menu.html?slug=' + slug;
    document.getElementById('menuLink').textContent = menuUrl;
    document.getElementById('successBox').style.display = 'block';

    document.getElementById('restaurantName').value = '';
    document.getElementById('dishName').value = '';
    document.getElementById('dishPrice').value = '';
    document.getElementById('dishDescription').value = '';
    document.getElementById('modelUrl').value = '';

    loadClients();
  }

  async function loadClients() {
    const { data, error } = await db
      .from('restaurants')
      .select('*')
      .order('created_at', { ascending: false });

    if (error) {
      document.getElementById('clientList').innerHTML = '<div class="empty-state">Error loading clients.</div>';
      return;
    }

    const total = data.length;
    document.getElementById('statTotal').textContent = total;
    document.getElementById('statMenus').textContent = total;
    document.getElementById('statRevenue').textContent = 'R' + (total * 800).toLocaleString();
    document.getElementById('clientCountBadge').textContent = total;

    if (total === 0) {
      document.getElementById('clientList').innerHTML = '<div class="empty-state">No clients yet — add your first restaurant above.</div>';
      return;
    }

    document.getElementById('clientList').innerHTML = data.map(client => `
      <div class="client-item">
        <div class="client-info">
          <div class="client-restaurant">${client.restaurant_name}</div>
          <div class="client-dish">${client.dish_name}</div>
        </div>
        <div class="client-price">${client.dish_price}</div>
        <div class="client-actions">
          <a class="view-link" href="/menu.html?slug=${client.slug}" target="_blank">View AR →</a>
          <button class="btn-secondary" onclick="copyClientLink('${client.slug}')">Copy</button>
        </div>
      </div>
    `).join('');
  }

  function copyLink() {
    const link = document.getElementById('menuLink').textContent;
    navigator.clipboard.writeText(link).then(() => alert('Link copied!'));
  }

  function copyClientLink(slug) {
    const link = window.location.origin + '/menu.html?slug=' + slug;
    navigator.clipboard.writeText(link).then(() => alert('Link copied!'));
  }

  document.getElementById('passwordInput').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') login();
  });
</script>

</body>
</html>
